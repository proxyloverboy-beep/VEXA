<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#05070A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VEXA"
        android:textColor="#FFFFFF"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR VOICE • YOUR ASSISTANT"
        android:textColor="#6FE7FF"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:padding="20dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="25dp"
        android:background="#10161D" />

    <Button
        android:id="@+id/listen"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:text="🎙  SPEAK TO VEXA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hindi + English • Voice commands • Phone monitor"
        android:textColor="#71808C"
        android:textSize="12sp"
        android:layout_marginTop="22dp" />
</LinearLayout>
