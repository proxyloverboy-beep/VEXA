<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#05070A">

    <ImageView
        android:id="@+id/vexaLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/vexa_logo"
        android:contentDescription="VEXA logo"
        android:scaleType="centerCrop" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VEXA"
        android:textColor="#FFFFFF"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR VOICE • YOUR ASSISTANT"
        android:textColor="#6FE7FF"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:padding="20dp"
        android:layout_marginTop="45dp"
        android:background="#10161D" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Say “Hey VEXA” — no button required"
        android:textColor="#71808C"
        android:textSize="13sp"
        android:layout_marginTop="24dp" />
</LinearLayout>
