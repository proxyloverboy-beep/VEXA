<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="#05070A">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="VEXA" android:textColor="#FFFFFF" android:textSize="42sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your voice. Your assistant." android:textColor="#90A4AE" android:textSize="16sp" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginTop="60dp" android:layout_marginBottom="30dp" />
    <Button android:id="@+id/listen" android:layout_width="220dp" android:layout_height="60dp"
        android:text="SPEAK TO VEXA" android:textSize="16sp" />
</LinearLayout>
